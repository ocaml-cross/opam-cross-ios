index a724a9a4b3..717a321919 100644
--- a/otherlibs/unix/socketaddr.c
+++ b/otherlibs/unix/socketaddr.c
@@ -20,6 +20,17 @@
 #include <errno.h>
 #include "unixsupport.h"
 
+#if defined(__APPLE__) && defined(__IPHONE_OS_VERSION_MIN_REQUIRED) \
+    && __IPHONE_OS_VERSION_MIN_REQUIRED < 50000
+/* strnlen was added to Darwin in iOS 5 / macOS 10.7. */
+static size_t strnlen(const char *s, size_t maxlen)
+{
+  size_t n = 0;
+  while (n < maxlen && s[n] != '\0') n++;
+  return n;
+}
+#endif
+
 #ifdef HAS_SOCKETS
 
 #include "socketaddr.h"
